# EdgeLab runs in research and paper mode by default.
ENABLE_LIVE_TRADING=false
DATABASE_URL=sqlite:///data/edgelab.sqlite
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
EDGELAB_CACHE_DIR=data/raw/cache/edgelab
EDGELAB_LIVE_DATA_DIR=data/live

# Optional real-data credentials. Do not commit real values.
ODDS_PROVIDER=disabled
ODDS_API_IO_KEY=
ODDS_API_IO_BASE=https://api.odds-api.io/v3
ODDS_API_IO_BOOKMAKERS=Bet365,Unibet
THE_ODDS_API_KEY=
THE_ODDS_API_BASE=https://api.the-odds-api.com/v4
THE_ODDS_API_SPORT_KEYS=soccer_epl
THE_ODDS_API_REGIONS=us,uk,eu
ODDS_PROVIDER_EVENT_LIMIT=20

# Backward-compatible fallback only. Prefer ODDS_API_IO_KEY or THE_ODDS_API_KEY.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_API_SPORT_KEYS=soccer_epl
CRYPTO_API_BASE=https://api.coingecko.com/api/v3
WEATHER_API_BASE=https://api.open-meteo.com/v1
WEATHER_API_KEY=
POLLING_API_KEY=
PROVIDER_RATE_LIMIT_PER_MINUTE=30
ODDS_RATE_LIMIT_PER_MINUTE=10
POLYMARKET_RATE_LIMIT_PER_MINUTE=75
CRYPTO_RATE_LIMIT_PER_MINUTE=30
WEATHER_RATE_LIMIT_PER_MINUTE=30

MAX_POSITION_PER_MARKET=250
MAX_POSITION_PER_EVENT=500
MAX_TOTAL_UNRESOLVED_EXPOSURE=2000
MAX_DAILY_LOSS=250
MAX_TRADE_SIZE=100
MIN_LIQUIDITY=10
MAX_SPREAD=0.08
MIN_ADJUSTED_EDGE=0.015
DEFAULT_SLIPPAGE_BPS=25
FEE_BPS=20
MODEL_UNCERTAINTY_BPS=75
RESOLUTION_RISK_BPS=30
SAFETY_MARGIN_BPS=50
MAX_DATA_AGE_SECONDS=900
MAX_ORDERBOOK_AGE_SECONDS=30
MAX_ODDS_AGE_SECONDS=180
MAX_CROSS_SOURCE_SKEW_SECONDS=60
# Optional human-reviewed settlement registry; no inferred equivalence by default.
SETTLEMENT_REGISTRY_FILE=
