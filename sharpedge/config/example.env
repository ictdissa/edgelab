# SharpEdge Sports example environment.
# Copy to .env and adjust locally. Never commit secrets.

POLYMARKET_API_BASE=https://data-api.polymarket.com
POLYMARKET_CLOB_BASE=https://clob.polymarket.com
POLYMARKET_GAMMA_BASE=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4

# Odds-API.io collector. Keep request cap <= 100/hour.
ODDS_API_IO_KEY=
ODDS_API_IO_BASE=https://api.odds-api.io/v3
ODDS_API_IO_BOOKMAKERS=Pinnacle,Bet365,Betfair,Unibet
ODDS_API_IO_MAX_REQUESTS_PER_HOUR=90
ODDS_API_IO_RATE_LIMIT_STATE=.sharpedge_cache/odds_api_io_rate_limit.json
ODDS_API_IO_CACHE_DIR=data/raw/cache/odds_api_io

DATABASE_URL=sqlite:///sharpedge.db
SHARPEDGE_MODE=research
ENABLE_LIVE_TRADING=false

MAX_POSITION_PER_MARKET=100
MAX_POSITION_PER_EVENT=250
MAX_TOTAL_UNRESOLVED_EXPOSURE=1000
MAX_DAILY_LOSS=100
MAX_TRADE_SIZE=25
MIN_ADJUSTED_EDGE=0.015
MIN_LIQUIDITY=5

DEFAULT_SLIPPAGE_BPS=20
MODEL_UNCERTAINTY_BPS=75
RESOLUTION_RISK_BPS=25
SAFETY_MARGIN_BPS=50

MAX_ORDERBOOK_AGE_SECONDS=120
MAX_ODDS_AGE_SECONDS=300
MIN_SECONDS_TO_START=300
